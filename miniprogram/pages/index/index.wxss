/* pages/index/index.wxss —— 还原 demo 视觉（rpx：750rpx = 屏宽） */

.screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f6fb;
}

.view {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ---------- 首页 ---------- */
.hero {
  background: linear-gradient(150deg, #2e7cf6, #19b6e8 60%, #57d6c4);
  padding: 12rpx 44rpx 64rpx;
  border-radius: 0 0 56rpx 56rpx;
  position: relative;
}
.hero .pin {
  position: absolute; right: 36rpx; top: 24rpx;
  width: 156rpx; height: 156rpx; border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex; align-items: center; justify-content: center;
  font-size: 76rpx;
}
.hero .eyebrow { font-size: 24rpx; letter-spacing: 6rpx; opacity: 0.85; font-weight: 600; }
.hero .h1 { margin: 16rpx 0 12rpx; font-size: 54rpx; font-weight: 800; line-height: 1.25; color: #fff; text-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.12); }
.hero .sub { font-size: 27rpx; opacity: 0.92; color: #fff; }

.scroll { flex: 1; min-height: 0; overflow-y: auto; }

.sheet {
  margin: -40rpx 32rpx 0;
  background: #fff;
  border-radius: 48rpx;
  box-shadow: 0 18rpx 50rpx -22rpx rgba(28, 40, 80, 0.38);
  padding: 40rpx 36rpx 44rpx;
  position: relative;
  z-index: 5;
}
.field { margin-bottom: 40rpx; }
.field:last-child { margin-bottom: 0; }
.label {
  font-size: 26rpx; font-weight: 700; color: #5a6478;
  display: flex; align-items: center; gap: 14rpx; margin-bottom: 22rpx;
}
.label .ic { font-size: 30rpx; }
.label .hint { margin-left: auto; font-weight: 500; color: #99a1b3; font-size: 23rpx; }

.search-box {
  display: flex; align-items: center; gap: 20rpx;
  background: #f4f6fb; border: 3rpx solid #eef1f6;
  border-radius: 28rpx; padding: 26rpx 28rpx;
}
.inp { flex: 1; font-size: 30rpx; color: #1c2230; }
.datepick { justify-content: space-between; }
.dp-text { font-size: 30rpx; color: #1c2230; }
.dp-caret { font-size: 28rpx; color: #5a6478; }

.pref-box {
  width: 100%; border: 3rpx solid #eef1f6; border-radius: 28rpx;
  padding: 24rpx 28rpx; font-size: 28rpx; color: #1c2230;
  background: #f4f6fb; line-height: 1.6; height: 160rpx;
}

.seg { display: flex; background: #f4f6fb; border-radius: 28rpx; padding: 8rpx; gap: 8rpx; }
.seg-item {
  flex: 1; text-align: center; padding: 20rpx 8rpx; border-radius: 22rpx;
  font-size: 27rpx; color: #5a6478; font-weight: 600;
}
.seg-item.on { background: #fff; color: #1c2230; box-shadow: 0 8rpx 28rpx -12rpx rgba(0, 0, 0, 0.18); }

.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip {
  border: 3rpx solid #eef1f6; background: #fff;
  padding: 18rpx 28rpx; border-radius: 24rpx;
  font-size: 27rpx; color: #5a6478; display: flex; align-items: center; gap: 12rpx;
}
.chip .emo { font-size: 30rpx; }
.chip.on { border-color: #2e7cf6; color: #2e7cf6; background: rgba(46, 124, 246, 0.08); font-weight: 600; }

.stepper { display: flex; align-items: center; }
.stepbtn {
  width: 80rpx; height: 80rpx; border-radius: 24rpx; border: 3rpx solid #eef1f6;
  background: #fff; font-size: 44rpx; color: #5a6478;
  display: flex; align-items: center; justify-content: center;
}
.stepval { flex: 1; text-align: center; font-size: 40rpx; font-weight: 800; color: #1c2230; }
.stepval .small { font-size: 26rpx; font-weight: 600; color: #99a1b3; margin-left: 6rpx; }

.cta {
  margin: 44rpx 32rpx 48rpx;
  background: linear-gradient(120deg, #ff8a4c, #ff5e7d);
  color: #fff; border-radius: 32rpx;
  padding: 32rpx; font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx;
  box-shadow: 0 32rpx 60rpx -24rpx rgba(255, 94, 125, 0.6);
  text-align: center;
}
.cta:active { transform: translateY(4rpx) scale(0.99); }

.examples { display: flex; gap: 16rpx; overflow-x: auto; margin: 0 4rpx; padding-bottom: 8rpx; }
.ex {
  flex: 0 0 auto; font-size: 24rpx; color: #2e7cf6;
  background: rgba(46, 124, 246, 0.08); border-radius: 40rpx; padding: 14rpx 26rpx; white-space: nowrap;
}

/* ---------- 加载页 ---------- */
.loading { background: linear-gradient(170deg, #0f1830, #16224a); color: #fff; }
.lwrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 60rpx; }
.orbit {
  width: 300rpx; height: 300rpx; border-radius: 50%; position: relative; margin-bottom: 76rpx;
  background: conic-gradient(from 0deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
  animation: spin 3.4s linear infinite;
}
.orbit::before { content: ""; position: absolute; inset: 28rpx; border-radius: 50%; border: 3rpx dashed rgba(255, 255, 255, 0.18); }
.globe { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 104rpx; animation: float 2.6s ease-in-out infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes float { 0%, 100% { transform: translateY(-8rpx); } 50% { transform: translateY(12rpx); } }
.ltitle { font-size: 42rpx; font-weight: 800; margin: 0 0 12rpx; }
.lsub { font-size: 26rpx; color: #9fb0d8; margin-bottom: 60rpx; }
.lsub2 { font-size: 23rpx; color: #9fb0d8; opacity: 0.7; margin-top: 12rpx; }

.agents { width: 100%; display: flex; flex-direction: column; gap: 24rpx; }
.agent {
  display: flex; align-items: center; gap: 26rpx;
  background: rgba(255, 255, 255, 0.06); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx; padding: 28rpx 30rpx;
  opacity: 0.5; transform: translateY(16rpx);
  transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.agent.show { opacity: 1; transform: translateY(0); }
.agent.done { border-color: rgba(7, 193, 96, 0.5); }
.agent .logo { width: 84rpx; height: 84rpx; border-radius: 24rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; font-size: 44rpx; background: rgba(255, 255, 255, 0.1); }
.agent .meta { flex: 1; }
.agent .meta .nm { font-size: 29rpx; font-weight: 700; }
.agent .meta .ds { font-size: 23rpx; color: #9fb0d8; margin-top: 4rpx; }
.agent .state { font-size: 24rpx; color: #9fb0d8; }
.agent.done .state { color: #07c160; }

/* ---------- 结果页 ---------- */
.rhead { background: linear-gradient(150deg, #2e7cf6, #19b6e8); padding: 12rpx 40rpx 44rpx; color: #fff; }
.summary { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; }
.city { font-size: 48rpx; font-weight: 800; }
.tag { font-size: 23rpx; opacity: 0.9; background: rgba(255, 255, 255, 0.2); padding: 6rpx 20rpx; border-radius: 40rpx; }
.reqnote { margin-top: 20rpx; font-size: 25rpx; line-height: 1.5; background: rgba(255, 255, 255, 0.18); border-radius: 24rpx; padding: 16rpx 24rpx; }
.facts { display: flex; gap: 36rpx; margin-top: 24rpx; }
.facts view { font-size: 25rpx; opacity: 0.92; }
.facts .b { display: block; font-size: 34rpx; font-weight: 800; margin-bottom: 2rpx; }

.weather-strip { display: flex; gap: 20rpx; overflow-x: auto; margin: 28rpx 32rpx 0; }
.wcard { flex: 0 0 auto; width: 172rpx; background: #fff; border-radius: 32rpx; padding: 24rpx 12rpx; text-align: center; box-shadow: 0 18rpx 50rpx -22rpx rgba(28, 40, 80, 0.4); }
.wcard .wd { font-size: 22rpx; color: #99a1b3; font-weight: 700; }
.wcard .wi { font-size: 56rpx; margin: 12rpx 0 8rpx; }
.wcard .wt { font-size: 26rpx; font-weight: 800; color: #1c2230; }
.wcard .ws { font-size: 21rpx; color: #5a6478; margin-top: 4rpx; }
.wcard.far { background: #eef0f5; }
.wcard.far .wi { opacity: 0.5; }
.wcard.far .wt { color: #99a1b3; font-size: 22rpx; }
.wcard.far .ws { color: #99a1b3; }

.wnote { margin: 18rpx 36rpx 0; font-size: 23rpx; color: #ff5e7d; line-height: 1.5; }
.wnote.ok { color: #99a1b3; }

.day { margin: 32rpx 32rpx 0; background: #fff; border-radius: 40rpx; box-shadow: 0 24rpx 60rpx -40rpx rgba(28, 40, 80, 0.4); overflow: hidden; }
.dhead { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; border-bottom: 2rpx solid #eef1f6; }
.dnum {
  width: 88rpx; height: 88rpx; border-radius: 26rpx; flex: 0 0 auto;
  background: linear-gradient(140deg, #2e7cf6, #19b6e8); color: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 800; font-size: 32rpx;
}
.dnum .small { font-size: 18rpx; font-weight: 600; opacity: 0.9; margin-top: 4rpx; }
.dcol { flex: 1; min-width: 0; }
.dtitle { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.dweather { font-size: 22rpx; font-weight: 700; color: #2e7cf6; background: rgba(46, 124, 246, 0.1); padding: 4rpx 18rpx; border-radius: 16rpx; }
.ddate { font-size: 23rpx; color: #99a1b3; margin-top: 6rpx; }

.acts { padding: 12rpx 32rpx 28rpx; }
.rslot { margin: 16rpx 0 8rpx; }
.rlabel { font-size: 24rpx; font-weight: 700; color: #2e7cf6; display: flex; align-items: center; gap: 14rpx; margin: 20rpx 0 4rpx; }
.rlabel::before { content: ""; width: 6rpx; height: 26rpx; border-radius: 6rpx; background: #2e7cf6; }
.ritem { display: flex; gap: 22rpx; padding: 20rpx 0; align-items: flex-start; border-bottom: 2rpx dashed #eef1f6; }
.ritem:last-child { border-bottom: none; }
.ricon { flex: 0 0 auto; width: 68rpx; height: 68rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08); }
.rbody { flex: 1; min-width: 0; }
.rtitle { font-size: 28rpx; font-weight: 700; display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.dur { font-size: 21rpx; font-weight: 700; color: #99a1b3; background: #f4f6fb; padding: 2rpx 16rpx; border-radius: 14rpx; border: 2rpx solid #eef1f6; }
.rnote { font-size: 25rpx; color: #5a6478; margin-top: 6rpx; line-height: 1.5; }
.adesc { font-size: 27rpx; color: #5a6478; line-height: 1.6; }

.tips { padding-left: 8rpx; }
.tip { font-size: 25rpx; color: #5a6478; margin: 10rpx 0; line-height: 1.5; }

.day-intro { background: linear-gradient(135deg, #f0f7ff, #fff8f0); }
.day-intro .dnum { background: #e8f0fe !important; color: #2e7cf6 !important; }

/* ---------- 结果页导航条（‹ 行程方案 ⋯） ---------- */
.rnav {
  display: flex; align-items: center; gap: 20rpx;
  padding: 0 0 22rpx;   /* 横向由 .rhead 的 padding 统一控制 */
}
.rnav-back { font-size: 48rpx; line-height: 1; opacity: .9; font-weight: 300; flex: 0 0 auto; }
.rnav-title { font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; flex: 1; }
.rnav-more { font-size: 44rpx; opacity: .85; flex: 0 0 auto; font-weight: 300; }

/* ---------- 下载卡 ---------- */
.downloads { display: flex; gap: 20rpx; margin: 36rpx 32rpx 0; }
.dl {
  flex: 1; background: #fff; border: 3rpx solid #eef1f6; border-radius: 28rpx;
  padding: 24rpx 12rpx; text-align: center;
}
.dl:active { transform: scale(.96); }
.di { font-size: 40rpx; }
.dt { font-size: 24rpx; color: #5a6478; margin-top: 6rpx; font-weight: 600; }

/* ---------- 分享条（view 版，保持原 feel） ---------- */
.sharebar {
  margin: 36rpx 32rpx 0; width: auto;
  background: #07c160; color: #fff; border-radius: 28rpx;
  padding: 28rpx; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.sharebar:active { transform: translateY(4rpx); }
.backhome { text-align: center; color: #5a6478; font-size: 27rpx; margin: 28rpx 0; }
.bottompad { height: 40rpx; }

/* ---------- AI 参考来源 ---------- */
.srcbox .srccount {
  display: inline-block; min-width: 44rpx; text-align: center;
  background: #eef4ff; color: #3a7afe; border-radius: 20rpx;
  font-size: 22rpx; font-weight: 700; padding: 2rpx 12rpx; margin-left: 10rpx;
}
.srcbox .srcnote { font-size: 22rpx; color: #9aa3b5; margin-left: auto; }
.src {
  padding: 20rpx 0; border-bottom: 2rpx dashed #eef1f6;
}
.src:last-of-type { border-bottom: none; }
.src-hover { background: #f7f9fc; }
.srcrow { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.stag {
  flex: 0 0 auto; font-size: 20rpx; font-weight: 700; color: #fff;
  border-radius: 8rpx; padding: 4rpx 12rpx;
}
.s-xhs  { background: #ff2e4d; }
.s-bd   { background: #3a7afe; }
.s-bili { background: #22aee5; }
.s-ctrip{ background: #00b4a0; }
.s-unk  { background: #8a93a6; }
.smeta {
  font-size: 21rpx; color: #9aa3b5;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.stit2 {
  font-size: 26rpx; font-weight: 600; color: #1c2333; line-height: 1.5;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.srcmore {
  text-align: center; font-size: 24rpx; color: #5a6478;
  background: #f4f6fa; border-radius: 16rpx; padding: 18rpx 0; margin-top: 8rpx;
}
.srcmore:active { background: #eceff5; }
.srchint { font-size: 21rpx; color: #b3bac8; text-align: center; margin-top: 14rpx; }

/* ---------- 小红书入口 ---------- */
.xhsbar {
  margin: 30rpx 32rpx 0; background: #ff2e4d; color: #fff;
  border-radius: 28rpx; padding: 26rpx; font-size: 29rpx; font-weight: 700;
  text-align: center;
}
.xhsbar:active { transform: translateY(4rpx); opacity: .92; }
