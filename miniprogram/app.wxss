/* app.wxss —— 全局样式（WXSS 用 rpx：750rpx = 屏幕宽） */

page {
  background: #f4f6fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  color: #1c2230;
  font-size: 28rpx;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx -22rpx rgba(28, 40, 80, 0.38);
}

/* 通用按钮去默认样式 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}
button::after { border: none; }
